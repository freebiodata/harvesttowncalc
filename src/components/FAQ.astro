---
interface QA { q: string; a: string }
const { items, heading = 'Frequently asked questions' }: { items: QA[]; heading?: string } = Astro.props;
---
<section>
 <h2>{heading}</h2>
 {items.map((item) => (
 <details class="faq">
 <summary>{item.q}</summary>
 <div class="a"><p set:html={item.a} /></div>
 </details>
 ))}
</section>
